---
layout: 'layouts/base.njk'
permalink: '/cv/'
title: CV - Alan Henry
description: Alan Henry's CV. DevOps Engineer with experience in automation, scripting, cloud computing and CI/CD pipelines.
---

<section class="graph-paper">
  <div class="wrap pb-12 pt-8 lg:pb-16 lg:pt-12">
    <h1
      class="display mt-8 text-[4rem] sm:text-[6.5rem] lg:mt-12 lg:text-[9rem] xl:text-[10rem]"
    >
      Curriculum<br />vitae<span class="text-signal">.</span>
    </h1>
  </div>
</section>

<section class="wrap grid gap-8 pb-24 lg:grid-cols-12 lg:gap-6">
  <aside class="space-y-6 lg:col-span-4">
    <a href="{{ site.cv }}" class="btn btn-primary" download
      >Download PDF <span aria-hidden="true">↓</span></a
    >

    <figure class="spec">
      <figcaption class="spec-head">
        <span>Experience</span>
      </figcaption>
      <ol>
        {% for item in site.record %}
        <li class="border-t border-hair px-3.5 py-3 first:border-t-0">
          <p class="label text-mute">{{ item.period }}</p>
          <p
            class="mt-1.5 font-display text-2xl font-bold uppercase leading-none tracking-[0.01em]"
          >
            {{ item.title }}
          </p>
          <p class="mt-1 text-sm text-ink/80">{{ item.org }}</p>
        </li>
        {% endfor %}
      </ol>
    </figure>

    <figure class="spec">
      <figcaption class="spec-head">
        <span>Certifications</span>
      </figcaption>
      <dl>
        {% for item in site.certifications %}
        <div class="spec-row">
          <dt>{{ item.date }}</dt>
          <dd>{{ item.name }}</dd>
        </div>
        {% endfor %}
      </dl>
    </figure>
  </aside>

  <div class="flex flex-col border-2 border-ink bg-sheet lg:col-span-8">
    <div class="spec-head">
      <span class="text-ash">PDF CV</span>
    </div>
    <object
      class="block h-[90vh] min-h-[48rem] w-full lg:h-auto lg:flex-1"
      data="{{ site.cv }}#view=FitH&amp;navpanes=0"
      type="application/pdf"
      aria-label="{{ site.name }}'s CV (PDF)"
    >
      <div class="flex h-full flex-col items-start justify-center gap-4 p-8">
        <p class="label text-mute">Preview unavailable</p>
        <p class="max-w-md text-lg leading-relaxed">
          Your browser can't display the PDF here. Download it to read the full
          CV.
        </p>
        <a href="{{ site.cv }}" class="btn btn-primary" download
          >Download PDF <span aria-hidden="true">↓</span></a
        >
      </div>
    </object>
  </div>
</section>
