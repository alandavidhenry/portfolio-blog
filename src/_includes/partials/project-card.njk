{#
  Portfolio card in the spec-sheet style.
  card: { name, technologies, description, url, github, image }
  ref: running project number, category: section label,
  wide: lay the image and text side by side (for a lone card in a section)
#}
{% macro projectCard(card, ref, category, wide = false) %}
{%- set paragraphs = card.description.split('\n\n') -%}
<article class="card group {{ 'md:col-span-2' if wide }}">
  <div class="card-head">
    <span>P-{{ ref | pad }} / {{ category }}</span>
    {% if card.url %}
    <span class="flex items-center gap-2"
      ><span class="size-2 bg-signal" aria-hidden="true"></span>Live</span
    >
    {% else %}
    <span class="flex items-center gap-2"
      ><span class="size-2 border border-current" aria-hidden="true"></span
      >Source only</span
    >
    {% endif %}
  </div>
  <div class="flex flex-1 flex-col {{ 'md:grid md:grid-cols-12' if wide }}">
    <img
      class="aspect-[3/2] w-full border-b-2 border-ink object-cover object-top {{ 'md:col-span-7 md:h-full md:border-b-0 md:border-r-2' if wide }}"
      src="/images/{{ card.image }}"
      alt="Screenshot of {{ card.name }}"
      width="1100"
      height="726"
      loading="lazy"
      decoding="async"
    />
    <div class="flex flex-1 flex-col gap-4 p-5 {{ 'md:col-span-5 lg:p-7' if wide }}">
      <h4
        class="font-display text-4xl font-bold uppercase leading-[0.9] tracking-[0.01em] {{ 'lg:text-5xl' if wide }}"
      >
        {{ card.name }}
      </h4>
      <p class="leading-relaxed text-ink/80">{{ paragraphs[0] | trim }}</p>
      {% if paragraphs.length > 1 %}
      <details class="brief">
        <summary>
          <span class="brief-icon text-signal" aria-hidden="true">+</span>
          <span class="brief-closed">Read full brief</span
          ><span class="brief-open">Close brief</span>
        </summary>
        <div
          class="mt-3 space-y-3 border-l-2 border-signal pl-4 leading-relaxed text-ink/80"
        >
          {% for paragraph in paragraphs %}{% if not loop.first %}
          <p>{{ paragraph | trim }}</p>
          {% endif %}{% endfor %}
        </div>
      </details>
      {% endif %}
      <dl class="mt-auto border-t border-hair">
        <div class="spec-row">
          <dt>Stack</dt>
          <dd>{{ card.technologies.split(' | ') | join(' · ') }}</dd>
        </div>
      </dl>
    </div>
  </div>
  <div class="card-foot">
    {% if card.url %}
    <a href="{{ card.url }}"
      ><span aria-hidden="true">↗</span> Live site<span class="sr-only">
        for {{ card.name }}</span
      ></a
    >
    {% else %}
    <span class="text-mute">— No live site</span>
    {% endif %} {% if card.github %}
    <a href="https://github.com/{{ card.github }}"
      ><span aria-hidden="true">↗</span> Source<span class="sr-only">
        code for {{ card.name }}</span
      ></a
    >
    {% else %}
    <span class="text-mute">— Private repo</span>
    {% endif %}
  </div>
</article>
{% endmacro %}
