    class="wrap flex flex-col gap-10 py-12 md:flex-row md:items-end md:justify-between"
  >
    <nav aria-label="Elsewhere">
      <ul class="label border-t border-char">
        <li class="border-b border-char">
          <a
            href="{{ site.links.github }}"
            class="flex justify-between py-3 transition-colors hover:text-signal"
            >GitHub <span aria-hidden="true">↗</span></a
          >
        </li>
        <li class="border-b border-char">
          <a
            href="{{ site.links.linkedin }}"
            class="flex justify-between py-3 transition-colors hover:text-signal"
            >LinkedIn <span aria-hidden="true">↗</span></a
          >
        </li>
        <li class="border-b border-char">
          <a
            href="{{ site.cv }}"
            class="flex justify-between py-3 transition-colors hover:text-signal"
