{%- set section = 'home' -%}
{%- set docRef = 'AH-00' -%}
{%- if page.url == '/cv/' -%}
  {%- set section = 'cv' -%}
  {%- set docRef = 'AH-02' -%}
{%- elif page.url == '/blog/' -%}
  {%- set section = 'blog' -%}
  {%- set docRef = 'AH-03' -%}
{%- elif '/posts/blog/' in page.url -%}
  {%- set section = 'post' -%}
  {%- set docRef = 'AH-03/N-' ~ (((collections.blog | getCollectionItemIndex(page)) + 1) | pad) -%}
{%- endif -%}

<a href="#main" class="skip-link">Skip to content</a>

<header class="border-b-2 border-ink">
  <div
    class="wrap flex flex-col gap-5 py-5 sm:flex-row sm:items-center sm:justify-between"
  >
    <a href="/" class="group w-fit">
      <span
        class="block font-display text-3xl font-extrabold uppercase leading-none transition-colors group-hover:text-signal"
        >{{ site.name }}</span
      >
      <span class="label mt-1 block text-mute"
        >{{ site.role }} — UK</span
      >
    </a>
    <nav aria-label="Main">
      <ul
        class="grid grid-cols-3 border-2 border-ink sm:flex sm:border-0"
      >
        <li>
          <a href="/#portfolio" class="nav-link"
            >
            Portfolio</a
          >
        </li>
        <li class="border-l-2 border-ink sm:border-l sm:border-hair">
          <a
            href="/cv/"
            class="nav-link"
            {% if section == 'cv' %}aria-current="page"{% endif %}
            > CV</a
          >
        </li>
        <li class="border-l-2 border-ink sm:border-l sm:border-hair">
          <a
            href="/blog/"
            class="nav-link"
            {% if section == 'blog' %}aria-current="page"{% elif section == 'post' %}aria-current="true"{% endif %}
            >
            Blog</a
          >
        </li>
      </ul>
    </nav>
  </div>
</header>
