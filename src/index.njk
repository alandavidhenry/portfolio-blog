---

{% from "partials/project-card.njk" import projectCard %}
{#- Empty placeholder cards (no name) are skipped, so a category appears once it has real entries -#}
{%- set devOpsCards = devOpsPortfolioCards | selectattr('name') -%}
{%- set cloudCards = cloudBasedPortfolioCards | selectattr('name') -%}
{%- set fullStackCards = fullStackPortfolioCards | selectattr('name') -%}
{%- set frontEndCards = frontEndPortfolioCards | selectattr('name') -%}
{%- set categories = [
  { title: 'DevOps', label: 'DevOps', cards: devOpsCards, offset: 0 },
  { title: 'Cloud-based', label: 'Cloud', cards: cloudCards, offset: devOpsCards.length },
  { title: 'Full stack', label: 'Full stack', cards: fullStackCards, offset: devOpsCards.length + cloudCards.length },
  { title: 'Front end', label: 'Front end', cards: frontEndCards, offset: devOpsCards.length + cloudCards.length + fullStackCards.length }
] -%}
{%- set projectCount = devOpsCards.length + cloudCards.length + fullStackCards.length + frontEndCards.length -%}
{%- set posts = collections.blog | reverse -%}

<section class="graph-paper" aria-labelledby="profile-title">
  <div class="wrap pb-16 pt-8 lg:pb-24 lg:pt-12">
    <div class="mt-8 grid gap-10 lg:mt-12 lg:grid-cols-12 lg:gap-6">
      <h1
        id="profile-title"
        class="display text-[5rem] sm:text-[8rem] md:text-[10rem] lg:col-span-8 lg:text-[9rem] xl:text-[11.75rem]"
      >
        <span class="sr-only">{{ site.name }}, </span>DevOps<br />Engineer<span
          class="text-signal"
          >.</span
        >
      </h1>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-12 md:gap-6 lg:mt-16">
      <div class="md:col-span-7">
        <p class="text-xl font-medium leading-snug sm:text-2xl">
          Analytical and self-driven DevOps Engineer, bringing expertise in
          automation, scripting, cloud computing, and CI/CD pipelines.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#portfolio" class="btn btn-primary"
            >View portfolio <span aria-hidden="true">↓</span></a
          >
          <a href="/cv/" class="btn btn-secondary"
            >Read CV <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
    </div>
  </div>
</section>

<section
  id="portfolio"
  class="wrap scroll-mt-4 pb-20"
  aria-labelledby="portfolio-title"
>
  <div class="section-head">
    <span class="section-num" aria-hidden="true">01</span>
    <h2 id="portfolio-title" class="section-title">Portfolio</h2>
  </div>

  <div class="space-y-14">
    {% for category in categories %}{% if category.cards.length %}
    <div>
      <h3 class="subhead">
        <span class="size-2 bg-signal" aria-hidden="true"></span>
        {{ category.title }}
        <span class="ml-auto text-mute">{{ category.cards.length | pad }}</span>
      </h3>
      <div class="grid gap-6 md:grid-cols-2">
        {% for card in category.cards %}
        {{ projectCard(card, category.offset + loop.index, category.label, loop.last and loop.length % 2 == 1) }}
        {% endfor %}
      </div>
    </div>
    {% endif %}{% endfor %}
  </div>
</section>

<section id="cv" class="wrap scroll-mt-4 pb-20" aria-labelledby="cv-title">
  <div class="section-head">
    <span class="section-num" aria-hidden="true">02</span>
    <h2 id="cv-title" class="section-title">CV</h2>
    <a href="/cv/" class="label link">Full record <span aria-hidden="true">→</span></a>
  </div>

  <div class="grid border-2 border-ink bg-sheet lg:grid-cols-12">
    <ol class="lg:col-span-8">
      {% for item in site.record %}
      <li
        class="grid gap-1 border-t border-hair p-5 first:border-t-0 sm:grid-cols-[9rem_1fr] sm:gap-6"
      >
        <span class="label pt-1 text-mute">{{ item.period }}</span>
        <div>
          <p
            class="font-display text-3xl font-bold uppercase leading-none tracking-[0.01em]"
          >
            {{ item.title }}
          </p>
          <p class="mt-1.5 text-ink/80">{{ item.org }}</p>
        </div>
      </li>
      {% endfor %}
    </ol>
    <div
      class="flex flex-col justify-between gap-8 bg-ink p-5 text-paper lg:col-span-4 lg:p-7"
    >
      <div>
        <p class="label flex items-center gap-2 text-ash">
          <span class="status-dot" aria-hidden="true"></span> Complete CV
        </p>
        <p
          class="mt-4 font-display text-4xl font-bold uppercase leading-[0.9] tracking-[0.01em]"
        >
          Skills, experience, projects &amp; certifications
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href="/cv/"
          class="btn border-signal bg-signal text-ink hover:border-paper hover:bg-paper"
          >Read CV <span aria-hidden="true">→</span></a
        >
        <a
          href="{{ site.cv }}"
          class="btn border-paper text-paper hover:bg-paper hover:text-ink"
          download
          >Download PDF <span aria-hidden="true">↓</span></a
        >
      </div>
    </div>
  </div>
</section>

<section class="wrap pb-24" aria-labelledby="notes-title">
  <div class="section-head">
    <span class="section-num" aria-hidden="true">03</span>
    <h2 id="notes-title" class="section-title">Field notes</h2>
    <a href="/blog/" class="label link"
      >All {{ posts.length }} entries <span aria-hidden="true">→</span></a
    >
  </div>

  <div class="border-2 border-ink bg-sheet">
    <div
      class="label hidden grid-cols-[7.5rem_1fr_7rem_1.5rem] gap-6 bg-ink px-5 py-2 text-paper md:grid"
      aria-hidden="true"
    >
      <span>Date</span><span>Title</span><span>Length</span><span></span>
    </div>
    <ol>
      {% for post in posts | head(3) %}
      <li
        class="register-row group relative flex flex-wrap items-baseline gap-x-4 gap-y-2 border-t border-hair px-5 py-4 transition-colors first:border-t-0 hover:bg-white md:grid md:grid-cols-[7.5rem_1fr_7rem_1.5rem] md:items-center md:gap-6 md:py-5"
      >
        <time class="label" datetime="{{ post.date | isoDate }}"
          >{{ post.date | isoDate }}</time
        >
        <a
          href="{{ post.url }}"
          class="stretched-link order-last w-full font-display text-3xl font-bold uppercase leading-none tracking-[0.01em] md:order-none md:text-4xl"
          >{{ post.data.title }}</a
        >
        <span class="label text-mute"
          >{{ post.content | readingTime }} min read</span
        >
        <span
          class="hidden text-right font-mono text-xl transition-transform group-hover:translate-x-1 md:block"
          aria-hidden="true"
          >→</span
        >
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
